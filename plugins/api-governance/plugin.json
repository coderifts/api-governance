{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "api-governance",
  "version": "1.2.9",
  "description": "Stops an agent's breaking edit to an OpenAPI, GraphQL, protobuf, AsyncAPI or MCP contract until a signed grant exists. The required check on the pull request stays the merge gate.",
  "author": {
    "name": "CodeRifts",
    "email": "peter@coderifts.com"
  },
  "homepage": "https://coderifts.com",
  "repository": "https://github.com/coderifts/api-governance",
  "license": "MIT",
  "keywords": [
    "coderifts",
    "api-governance",
    "breaking-change",
    "openapi",
    "mcp",
    "preflight",
    "receipt"
  ],
  "extensions": {
    "io.github.coderifts": {
      "catalogId": "io.github.coderifts/contract-authorization",
      "derivedFrom": ".claude-plugin/plugin.json"
    }
  }
}
